{
  "name": "human",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "HUMAN \u2014 India-first preventive healthcare and personal health intelligence platform",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "portable": "tsc -b && vite build --config vite.config.portable.ts && node scripts/build-portable.mjs",
    "typecheck": "tsc -b --noEmit",
    "build:embed": "vite build --config vite.config.embed.ts && node -e \"require('fs').renameSync('site/public/app-embed/app-embed.html','site/public/app-embed/index.html')\""
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
